    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260908.0-alpha",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
